<configuration>
	
	<property name="LOG_LEVEL" value="${LOG_LEVEL:-INFO}" />
	
	<timestamp key="bySecond" datePattern="yyyy-MM-dd_HH-mm-ss" />
	
	<appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
		<encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
			<!-- detailní vývojový pattern: čas, level, thread, MDC (traceId,userId), logger, message, stacktrace -->
			<pattern>%d{HH:mm:ss.SSS} %-5level [%thread][%X{traceId:-}|%X{userId:-}][%logger{36}] %msg%n%ex{full}</pattern>
			<immediateFlush>true</immediateFlush>
		</encoder>
	</appender>
	
	<root level="${LOG_LEVEL}">
		<appender-ref ref="CONSOLE" />
	</root>
	
</configuration>
